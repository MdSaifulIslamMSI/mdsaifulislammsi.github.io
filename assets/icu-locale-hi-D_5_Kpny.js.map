  "admin.users.error.loadUsers": "उपयोगकर्ताओं को लोड करने में विफल",
  "admin.users.error.selectUser": "पहले एक उपयोगकर्ता चुनें",
  "admin.users.explainer.delete.adminPower": "खाते को सॉफ़्ट-डिलीट करता है, विक्रेता गतिविधि को अक्षम करता है, वैकल्पिक रूप से PII को स्क्रब करता है, और पुनर्प्राप्ति ट्रेल रिकॉर्ड करता है।",
  "admin.users.explainer.delete.resolution": "पुनर्प्राप्ति को समर्थन ईमेल और आंतरिक मॉडरेशन मामले के माध्यम से नियंत्रित किया जाता है, न कि आकस्मिक इन-ऐप रिवर्सल के माध्यम से।",
  "admin.users.explainer.delete.userImpact": "उपयोगकर्ता सामान्य ऐप एक्सेस खो देता है और यदि यह कोई गलती थी तो उसे पुनर्प्राप्ति सहायता से गुजरना होगा।",
  "admin.users.explainer.dismiss.adminPower": "चेतावनी साफ़ करता है और खाते को बिना निलंबन के सक्रिय पर पुनर्स्थापित करता है।",
  "admin.users.explainer.dismiss.resolution": "मॉडरेशन मामला हल हो गया है और ऑडिट टाइमलाइन में रहता है।",
  "admin.users.explainer.dismiss.userImpact": "उपयोगकर्ता देखता है कि चेतावनी की निष्पक्ष समीक्षा की गई और उसे हटा दिया गया।",
  "admin.users.explainer.reactivate.adminPower": "सक्रिय निलंबन समाप्त करता है और खाते को कार्यशील स्थिति में पुनर्स्थापित करता है।",
  "admin.users.explainer.reactivate.resolution": "खुली निलंबन अपील का समाधान कर दिया गया है और परिणाम उसी मामले से जुड़ा हुआ है।",
  "admin.users.explainer.reactivate.userImpact": "उपयोगकर्ता को एक स्पष्ट पुनर्प्राप्ति क्षण मिलता है और वह सामान्य खाते का उपयोग फिर से शुरू कर सकता है।",
  "admin.users.explainer.suspend.adminPower": "खाते को अस्थायी रूप से ब्लॉक कर देता है, विक्रेता मोड को अक्षम कर देता है, सक्रिय लिस्टिंग समाप्त कर देता है, और एक तत्काल अपील मामला खोल देता है।",
  "admin.users.explainer.suspend.resolution": "समीक्षा के बाद व्यवस्थापक खाते को पुनः सक्रिय करता है, जो रिकॉर्ड किए गए परिणाम के साथ निलंबन मामले को बंद कर देता है।",
  "admin.users.explainer.suspend.userImpact": "उपयोगकर्ता को तुरंत प्रतिबंध महसूस होता है क्योंकि एक्सेस-संवेदनशील क्रियाएं काम करना बंद कर देती हैं और मामला अत्यावश्यक हो जाता है।",
  "admin.users.explainer.warn.adminPower": "एक औपचारिक नीति चेतावनी रिकॉर्ड करता है, उपयोगकर्ता को सूचित करता है, और एक मॉडरेशन अपील मामला खोलता है।",
  "admin.users.explainer.warn.resolution": "व्यवस्थापक या समर्थन समर्थन में अपील की समीक्षा कर सकता है, फिर उचित होने पर चेतावनी को खारिज कर सकता है।",
  "admin.users.explainer.warn.userImpact": "उपयोगकर्ता पहुंच रखता है, लेकिन स्पष्ट रूप से देखता है कि विश्वास और सुरक्षा खाते पर नजर रख रही है।",
