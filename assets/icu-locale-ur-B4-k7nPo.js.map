  "login.trust.otp.phone.signup": "آپ کا ای میل پتہ اب اس نئے اکاؤنٹ کے لیے تصدیق شدہ ہے۔",
  "login.trust.reset.1": "اس پاس ورڈ کی تبدیلی کی اجازت اسی ای میل اور فون کی تصدیق شدہ وصولی کے بعد ہی دی جاتی ہے۔",
  "login.trust.reset.2": "آپ کے نئے پاس ورڈ کو محفوظ کرنے سے پہلے اسے مکمل سیکیورٹی پالیسی پر پورا اترنا چاہیے۔",
  "login.trust.reset.3": "موجودہ Firebase سیشنز کو دوبارہ ترتیب دینے کے بعد منسوخ کر دیا جاتا ہے تاکہ نیا پاس ورڈ صاف طور پر اثر انداز ہو۔",
  "login.trust.signin.1dual": "پہلے پاس ورڈ کی تصدیق کی جاتی ہے، پھر لاگ ان کوڈز آپ کے ای میل اور آپ کے Firebase فون چینل دونوں پر بھیجے جاتے ہیں۔",
  "login.trust.signin.1fallback": "Firebase فون کی توثیق یہاں دستیاب نہیں ہے، لہذا Aura ای میل اور موبائل پر بیک اپ محفوظ ڈیلیوری کا استعمال کرتی ہے۔",
  "login.trust.signin.1single": "OTP جاری کرنے سے پہلے پاس ورڈ کی درستگی کی تصدیق کی جاتی ہے۔",
  "login.trust.signin.2": "ٹیلی فون کی تصدیق سیشن ختم ہونے سے پہلے اکاؤنٹ پر قبضے کا خطرہ کم کر دیتی ہے۔",
  "login.trust.signin.3": "شرح کی حدیں، ڈیوائس کی جانچ پڑتال، اور آڈٹ لاگ بار بار کی کوششوں کی حفاظت کرتے ہیں۔",
  "login.trust.signup.1dual": "پہلے ای میل کی تصدیق ہوتی ہے، پھر Firebase فون کی توثیق نئے اکاؤنٹ کو محفوظ طریقے سے حتمی شکل دیتی ہے۔",
  "login.trust.signup.1fallback": "Firebase فون کی ڈیلیوری یہاں دستیاب نہیں ہے، لہذا Aura اکاؤنٹ بنانے سے پہلے ای میل اور موبائل پر بیک اپ محفوظ ڈیلیوری کا استعمال کرتی ہے۔",
  "login.trust.signup.1single": "نیا اکاؤنٹ چالو کرنے سے پہلے ای میل اور فون کی تصدیق کی جاتی ہے۔",
  "login.trust.signup.2": "تصدیق شدہ شناخت کے بعد بیچنے والے، ادائیگی اور آرڈرز تک رسائی مسدود رہتی ہے۔",
  "login.trust.signup.3": "ایکٹیویشن سے پہلے فراڈ چیک اور ڈپلیکیٹ اکاؤنٹ کنٹرول کیے جاتے ہیں۔",
