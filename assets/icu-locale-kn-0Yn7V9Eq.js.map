  "admin.users.error.loadUsers": "ಬಳಕೆದಾರರನ್ನು ಲೋಡ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ",
  "admin.users.error.selectUser": "ಮೊದಲು ಬಳಕೆದಾರರನ್ನು ಆಯ್ಕೆಮಾಡಿ",
  "admin.users.explainer.delete.adminPower": "ಖಾತೆಯನ್ನು ಸಾಫ್ಟ್-ಡಿಲೀಟ್ ಮಾಡುತ್ತದೆ, ಮಾರಾಟಗಾರರ ಚಟುವಟಿಕೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ, ಐಚ್ಛಿಕವಾಗಿ PII ಅನ್ನು ಸ್ಕ್ರಬ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ರಿಕವರಿ ಟ್ರಯಲ್ ಅನ್ನು ದಾಖಲಿಸುತ್ತದೆ.",
  "admin.users.explainer.delete.resolution": "ಮರುಪ್ರಾಪ್ತಿಯನ್ನು ಬೆಂಬಲ ಇಮೇಲ್ ಮತ್ತು ಆಂತರಿಕ ಮಾಡರೇಶನ್ ಕೇಸ್ ಮೂಲಕ ನಿರ್ವಹಿಸಲಾಗುತ್ತದೆ, ಕ್ಯಾಶುಯಲ್ ಇನ್-ಆಪ್ ರಿವರ್ಸಲ್ ಅಲ್ಲ.",
  "admin.users.explainer.delete.userImpact": "ಬಳಕೆದಾರರು ಸಾಮಾನ್ಯ ಅಪ್ಲಿಕೇಶನ್ ಪ್ರವೇಶವನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಾರೆ ಮತ್ತು ಇದು ತಪ್ಪಾಗಿದ್ದರೆ ಮರುಪ್ರಾಪ್ತಿ ಬೆಂಬಲದ ಮೂಲಕ ಹೋಗಬೇಕು.",
  "admin.users.explainer.dismiss.adminPower": "ಎಚ್ಚರಿಕೆಯನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ ಮತ್ತು ಖಾತೆಯನ್ನು ಅಮಾನತುಗೊಳಿಸದೆ ಸಕ್ರಿಯವಾಗಿ ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ.",
  "admin.users.explainer.dismiss.resolution": "ಮಾಡರೇಶನ್ ಪ್ರಕರಣವನ್ನು ಪರಿಹರಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ ಮತ್ತು ಆಡಿಟ್ ಟೈಮ್‌ಲೈನ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತದೆ.",
  "admin.users.explainer.dismiss.userImpact": "ಎಚ್ಚರಿಕೆಯನ್ನು ನ್ಯಾಯಯುತವಾಗಿ ಪರಿಶೀಲಿಸಲಾಗಿದೆ ಮತ್ತು ತೆಗೆದುಹಾಕಲಾಗಿದೆ ಎಂದು ಬಳಕೆದಾರರು ನೋಡುತ್ತಾರೆ.",
  "admin.users.explainer.reactivate.adminPower": "ಸಕ್ರಿಯ ಅಮಾನತು ಕೊನೆಗೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಖಾತೆಯನ್ನು ಕಾರ್ಯ ಸ್ಥಿತಿಗೆ ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ.",
  "admin.users.explainer.reactivate.resolution": "ಮುಕ್ತ ಅಮಾನತು ಮನವಿಯನ್ನು ಪರಿಹರಿಸಲಾಗಿದೆ ಮತ್ತು ಫಲಿತಾಂಶವನ್ನು ಅದೇ ಪ್ರಕರಣಕ್ಕೆ ಲಗತ್ತಿಸಲಾಗಿದೆ.",
  "admin.users.explainer.reactivate.userImpact": "ಬಳಕೆದಾರರು ಸ್ಪಷ್ಟವಾದ ಚೇತರಿಕೆಯ ಕ್ಷಣವನ್ನು ಪಡೆಯುತ್ತಾರೆ ಮತ್ತು ಸಾಮಾನ್ಯ ಖಾತೆಯ ಬಳಕೆಯನ್ನು ಪುನರಾರಂಭಿಸಬಹುದು.",
  "admin.users.explainer.suspend.adminPower": "ಖಾತೆಯನ್ನು ತಾತ್ಕಾಲಿಕವಾಗಿ ನಿರ್ಬಂಧಿಸುತ್ತದೆ, ಮಾರಾಟಗಾರರ ಮೋಡ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ, ಸಕ್ರಿಯ ಪಟ್ಟಿಗಳನ್ನು ಮುಕ್ತಾಯಗೊಳಿಸುತ್ತದೆ ಮತ್ತು ತುರ್ತು ಮೇಲ್ಮನವಿ ಪ್ರಕರಣವನ್ನು ತೆರೆಯುತ್ತದೆ.",
  "admin.users.explainer.suspend.resolution": "ಪರಿಶೀಲನೆಯ ನಂತರ ನಿರ್ವಾಹಕರು ಖಾತೆಯನ್ನು ಪುನಃ ಸಕ್ರಿಯಗೊಳಿಸುತ್ತಾರೆ, ಇದು ಅಮಾನತು ಪ್ರಕರಣವನ್ನು ದಾಖಲಿಸಿದ ಫಲಿತಾಂಶದೊಂದಿಗೆ ಮುಚ್ಚುತ್ತದೆ.",
  "admin.users.explainer.suspend.userImpact": "ಪ್ರವೇಶ-ಸೂಕ್ಷ್ಮ ಕ್ರಿಯೆಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸುವುದನ್ನು ನಿಲ್ಲಿಸುವುದರಿಂದ ಮತ್ತು ಪ್ರಕರಣವು ತುರ್ತು ಆಗುವುದರಿಂದ ಬಳಕೆದಾರರು ತಕ್ಷಣವೇ ನಿರ್ಬಂಧವನ್ನು ಅನುಭವಿಸುತ್ತಾರೆ.",
  "admin.users.explainer.warn.adminPower": "ಔಪಚಾರಿಕ ನೀತಿ ಎಚ್ಚರಿಕೆಯನ್ನು ದಾಖಲಿಸುತ್ತದೆ, ಬಳಕೆದಾರರಿಗೆ ಸೂಚನೆ ನೀಡುತ್ತದೆ ಮತ್ತು ಮಾಡರೇಶನ್ ಮೇಲ್ಮನವಿ ಪ್ರಕರಣವನ್ನು ತೆರೆಯುತ್ತದೆ.",
  "admin.users.explainer.warn.resolution": "ನಿರ್ವಾಹಕರು ಅಥವಾ ಬೆಂಬಲವು ಮೇಲ್ಮನವಿಯನ್ನು ಬೆಂಬಲದಲ್ಲಿ ಪರಿಶೀಲಿಸಬಹುದು, ನಂತರ ಸಮರ್ಥಿಸಿದರೆ ಎಚ್ಚರಿಕೆಯನ್ನು ವಜಾಗೊಳಿಸಬಹುದು.",
